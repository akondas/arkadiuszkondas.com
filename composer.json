{
    "name": "akondas/arkadiuszkondas.com",
    "description": "personal site",
    "authors": [
        {
            "name": "Arkadiusz Kondas",
            "email": "arkadiusz.kondas@gmail.com"
        }
    ],
    "autoload": {
      "psr-4": {
        "Akondas\\": "src"
      }
    },
    "require": {
        "symplify/statie": "^5.3",
        "tovic/parsedown-extra-plugin": "^1.1",
        "php-ai/php-ml": "^0.7.0",
        "latte/latte": "2.5.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^0.10",
        "symplify/easy-coding-standard": "^5.3"
    },
    "scripts": {
      "post-install-cmd": "@patch-vendor",
      "post-update-cmd": "@patch-vendor",
      "patch-vendor": "php patches/apply.php",
      "check": [
        "@ecs",
        "@phpstan"
      ],
      "ecs": "ecs check src",
      "fix": "ecs check --fix src",
      "phpstan": "phpstan analyse -l max src --ansi",
      "build": "vendor/bin/statie generate site --output=dist"
    }
}
